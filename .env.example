# Docker Compose example settings; copy to the repository root as .env.
APP_ENV=development
AUTO_SEED=true
MYSQL_PORT=3308
BACKEND_PORT=8000
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password
QR_HMAC_SECRET=replace-with-a-long-random-secret
# Minutes either side of the start time when check-in is open; raise it only for a demo.
CHECKIN_WINDOW_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:63342
